generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App profile for a Supabase Auth user. `id` matches auth.users.id.
model User {
  id            String          @id @db.Uuid
  email         String          @unique
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  /// Account-wide currency earned by beating runs, spent in the post-run shop.
  exp           Int             @default(0)
  /// ₱ banked from earlier runs: each run's ₱ is moved here when it ends.
  bank          Int             @default(0)
  /// Stardust, the crafting currency: earned for every card pulled from a pack, spent crafting cards in the deck builder.
  stardust      Int             @default(0)
  /// The trainer sprite shown on the Inventory tab (a name from the shared package's TRAINER_SPRITES); null is the default, Hilbert.
  trainerSprite String?
  /// The player's sprite on the run maps: 'female' for the girl (Leaf, Lyra, May); null is the boy (Red, Ethan, Brendan).
  playerGender  String?
  /// The name the account chose to be shown by, on its Community Decks (not unique; null until it's chosen). Never the
  /// Google profile's name (displayName), which is private.
  accountName   String?
  /// The account's deck played most recently (a run started with it, a run's battle switched to it, or a Practice battle):
  /// the next run's deck to start with. Not a relation: a deleted deck's id is just ignored.
  lastDeckId    String?         @db.Uuid
  /// Consumables used from the Inventory while no run was under way (item ids, already taken from the inventory; at most a
  /// run's 3): they all take effect when the next run starts (among that run's 3), then this is cleared.
  pendingConsumables String[]   @default([])
  /// The cosmetics in use (ids from the campaign package's COSMETICS): the player's card back, playmat and coin; null is the default.
  cardBack      String?
  playmat       String?
  coin          String?
  /// The Settings page's choices kept with the account, so they follow it to any browser (the shared package's
  /// ACCOUNT_SETTINGS: theme, font, skipFlips, options, reminders, music), each the web app's own value as a string.
  settings      Json            @default("{}")
  /// The Settings page's debug switches (the API's DebugFlags: unlockAll, and million: 1,000,000 ₱ added to the bank),
  /// read and set only while debugging (debugProcedure, never in production). {} is both off.
  debugFlags    Json            @default("{}")
  /// The Extras page's Berry Farm: when each berry's tree was last planted (the campaign package's BerryFarm, {} until it's
  /// first opened; a berry missing is planted then).
  berryFarm     Json            @default("{}")
  /// The berries the account has, a count per berry id ('cheri'): picked on the Berry Farm, used in the Berry Blender.
  berries       Json            @default("{}")
  /// The Berry Blender's top speed ever, in hundredths of an RPM (as the game's record).
  blenderRecord Int             @default(0)
  /// The highest Battle Tower floor beaten in any challenge (0 for none): later challenges can start on the floor after
  /// each checkpoint up to it (the campaign package's startFloors).
  towerBest     Int             @default(0)
  /// Battle Points: the Battle Tower's currency, won with each of its wins and spent in its lobby's BP Shop (packs, for now).
  bp            Int             @default(0)
  /// The Game Corner's Coin Case: coins bought with banked ₱ and played at the roulette and the slots, or won at Voltorb Flip (at most 9999).
  coins         Int             @default(0)
  /// Voltorb Flip's session (the campaign package's VoltorbFlipState): its last 5 rounds, for the level, and the board in play.
  voltorbFlip   Json            @default("{}")
  /// The Super Contest under way (the campaign package's ContestState, README: Super Contests); {} when none is.
  contest       Json            @default("{}")
  /// The Idle Adventure's settings (the idle package's IdleSettings: auto-heal, auto-catch, full-party toggles,
  /// auto-evolve, playback speed); {} is the defaults.
  idleSettings  Json            @default("{}")
  decks         Deck[]
  games         Game[]
  runs          Run[]
  towers        TowerChallenge[]
  cardUnlocks   CardUnlock[]
  packUnlocks   PackUnlock[]
  favoriteCards FavoriteCard[]
  communityDecks CommunityDeck[]
  items        InventoryItem[]
  cosmetics    CosmeticUnlock[]
  flairUnlocks  FlairUnlock[]
  cardFlair     CardFlair[]
  equipment     Equipment[]
  pokeblocks    Pokeblock[]
  poffins       Poffin[]
  idleRuns      IdleRun[]
  idleDex       IdleDex[]
  whosThat      WhosThatGame[]
}

/// A game of the Extras page's Who's That Pokémon? (README: Who's That Pokémon?): its 10 cards, the one on screen (`index`)
/// and when the server showed it, each one named's time in ms (a pass counts the campaign package's WHOS_THAT_PASS_MS) and
/// whether it was passed; once finished, its fastest and average times (the leaderboards'). `day` is the daily playlist's
/// ("2026-10-26", one game a player a day), null for a game of random Pokémon.
model WhosThatGame {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String?
  cards      String[]
  index      Int       @default(0)
  shownAt    DateTime  @default(now())
  times      Int[]     @default([])
  passed     Boolean[] @default([])
  finishedAt DateTime?
  fastestMs  Int?
  averageMs  Int?
  createdAt  DateTime  @default(now())

  @@unique([userId, day])
  @@index([day, averageMs])
}

enum CardKind {
  POKEMON
  ENERGY
  TRAINER
}

/// Card set, imported from TCGdex (e.g. "base1" = Base Set).
model CardSet {
  id          String    @id
  name        String
  /// TCGdex series id, e.g. "base", "gym", "neo".
  series      String
  releaseDate DateTime? @db.Date
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  cards       Card[]
}

/// Card catalog, imported from TCGdex. `id` is the TCGdex card id (e.g. "base1-4").
model Card {
  id         String         @id
  setId      String
  set        CardSet        @relation(fields: [setId], references: [id])
  /// Number within the set, e.g. "4".
  localId    String
  name       String
  kind       CardKind
  /// TCGdex asset base URL; append "/high.webp" or "/low.webp".
  imageUrl   String?
  rarity     String?
  hp         Int?
  /// Pokémon types, e.g. ["Fire"].
  types      String[]
  /// "Basic" | "Stage1" | "Stage2" (Pokémon only).
  stage      String?
  evolveFrom String?
  /// Remaining TCGdex fields: attacks, abilities, weaknesses, resistances, retreat, effect, ...
  data       Json
  deckCards  DeckCard[]
  unlocks    CardUnlock[]
  favorites  FavoriteCard[]
  communityDeckCards CommunityDeckCard[]

  @@index([setId])
  @@index([name])
}

model Deck {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Place in the account's deck list, which can be reordered (lowest first).
  position  Int        @default(0)
  /// Set on the account's automatic run deck: a copy of this run's deck that the server keeps up to date (read-only
  /// in the deck builder). Saving it when the run is over clears it; otherwise the next run takes it over.
  runId     String?    @unique @db.Uuid
  run       Run?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Starred on the Collection tab: offered under the run's deck choice (Favorite decks).
  favorite  Boolean    @default(false)
  /// The deck's own cosmetics (ids from the campaign package's COSMETICS), used in its battles; null is the account's
  /// (User.cardBack, playmat, coin). The run deck takes the run's starting (or switched-to) deck's.
  cardBack  String?
  playmat   String?
  coin      String?
  cards     DeckCard[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
}

model DeckCard {
  deckId   String @db.Uuid
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int

  @@id([deckId, cardId])
}

/// A deck published to the Community Decks tab: a snapshot of one of the author's decks when it was published (later
/// edits to the deck don't change it), its holos as their non-holo versions. Every account can see it and import it.
model CommunityDeck {
  id          String              @id @default(uuid()) @db.Uuid
  authorId    String              @db.Uuid
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String              @default("")
  cards       CommunityDeckCard[]
  createdAt   DateTime            @default(now())

  @@index([createdAt])
}

model CommunityDeckCard {
  communityDeckId String        @db.Uuid
  communityDeck   CommunityDeck @relation(fields: [communityDeckId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card          @relation(fields: [cardId], references: [id])
  quantity        Int

  @@id([communityDeckId, cardId])
}

enum GameStatus {
  ACTIVE
  FINISHED
}

/// A single-player battle against a CPU opponent.
/// Engine player ids are "player" (the user) and "cpu".
model Game {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    GameStatus   @default(ACTIVE)
  /// Authoritative engine state. Contains hidden info – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Engine player id of the winner.
  winner    String?
  /// The run this battle belongs to (null for test games).
  runId     String?      @db.Uuid
  run       Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// The Battle Tower challenge this battle belongs to (null outside one).
  towerId   String?      @db.Uuid
  tower     TowerChallenge? @relation(fields: [towerId], references: [id], onDelete: SetNull)
  /// The player's deck's cosmetics when the game began ({ cardBack, playmat, coin }, each an id or null for the
  /// account's own); null for a game without a deck of the account's (the test deck) or from before decks had them.
  cosmetics Json?
  actions   GameAction[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, updatedAt])
}

/// Append-only log of accepted actions (player and CPU) – enables replays and debugging.
model GameAction {
  id        BigInt   @id @default(autoincrement())
  gameId    String   @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Engine player id that took the action.
  playerId  String
  /// state.version after this action was applied.
  version   Int
  action    Json
  createdAt DateTime @default(now())

  @@unique([gameId, version])
}

enum RunStatus {
  ACTIVE
  WON
  LOST
}

/// A run: encounters and battles leading up to a gym leader (see @poke-tcg/campaign).
model Run {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Run type id, e.g. "celadon".
  type      String
  status    RunStatus @default(ACTIVE)
  /// The campaign package's RunState (map, HP, ₱, deck, current encounter). Contains RNG state – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Rewards for beating it (EXP, unlocks, badge) have been given.
  rewarded  Boolean   @default(false)
  /// Its ₱ has been moved to the bank (when it ended).
  banked    Boolean   @default(false)
  /// The post-run shop's stock after it (item ids), fixed the first time the shop is opened once it's over, so buying
  /// something doesn't change what's offered. Null until then.
  shop      Json?
  games     Game[]
  /// The automatic deck copying this run's deck, until it's saved or the next run takes it over.
  deck      Deck?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId, createdAt])
}

enum TowerStatus {
  ACTIVE
  LOST
  /// Floor 100 beaten.
  WON
}

/// A Battle Tower challenge (see @poke-tcg/campaign's tower.ts): battles won one after another with one deck until one is
/// lost (or given up), or floor 100 is beaten (WON). An ACTIVE one keeps its saved flag in its state. Its deck is kept only here, in
/// `state.deck` (never a Deck row, so it's in no deck list), and shown only to take the challenge up.
model TowerChallenge {
  id        String      @id @default(uuid()) @db.Uuid
  ownerId   String      @db.Uuid
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    TowerStatus @default(ACTIVE)
  /// The campaign package's TowerState (floor, deck, opponent). Contains RNG state – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// The account deck it was started with (not a relation: the deck can be changed or deleted, the challenge's copy stays).
  deckId    String?     @db.Uuid
  /// That deck's cosmetics when it was started ({ cardBack, playmat, coin }, as Game.cosmetics), for every battle.
  cosmetics Json?
  games     Game[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ownerId, status])
}

/// Cards an account has unlocked by beating runs, for the deck builder (to come).
model CardUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  /// Copies unlocked.
  quantity  Int
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Cards an account has marked as favorites on the Collection tab (its Favorites list and filter).
model FavoriteCard {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Booster packs an account can buy (by set id, e.g. "base2"): a run's first battle finished without conceding unlocks
/// its generation's next pack, beating a run all of them (see the campaign package's GENERATIONS).
/// A Pokéblock made in the Extras page's Berry Blender (the campaign package's makePokeblock): its colour (POKEBLOCK_COLORS),
/// its 5 flavours (spicy, dry, sweet, bitter, sour), its feel, and the berries and top speed it was made with.
model Pokeblock {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  color     String
  flavors   Int[]
  feel      Int
  berries   String[]
  maxRpm    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A Poffin cooked on the Extras page (the campaign package's makePoffin): its type (an index into POFFIN_TYPES), its 5
/// flavours (spicy, dry, sweet, bitter, sour), its smoothness, and the berries, time (frames, 30 a second), spills and
/// burns it was cooked with.
model Poffin {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       Int
  flavors    Int[]
  smoothness Int
  berries    String[]
  frames     Int
  spills     Int
  burns      Int
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Cosmetics an account has bought (`cosmeticId`: a key of the campaign package's COSMETICS). The defaults, and those
/// unlocked by beating a run type, have no row: they're worked out (hasCosmetic).

model CosmeticUnlock {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId String
  createdAt  DateTime @default(now())

  @@id([userId, cosmeticId])
}

/// Card flair an account has bought with Stardust (the campaign package's flair.ts), each for one card alone (`cardId`):
/// a `slot` ("pattern") and its `key` (a HOLO_PATTERNS key). The card's own look has no row: it's always had.
model FlairUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  slot      String
  key       String
  createdAt DateTime @default(now())

  @@id([userId, cardId, slot, key])
}

/// The flair a card shows, on every copy of it in every deck (account-wide): one `key` per `slot`, one the account
/// bought (FlairUnlock). No row is the card's own look.
model CardFlair {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId String
  slot   String
  key    String

  @@id([userId, cardId, slot])
}

model PackUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  createdAt DateTime @default(now())

  @@id([userId, setId])
}

/// Items an account owns (consumables, misc items, key items, equipment). `itemId` is a key of the campaign package's ITEMS.
model InventoryItem {
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int

  @@id([userId, itemId])
}

/// What's equipped in each slot (head, chest, legs, pokeball, accessory1, accessory2).
model Equipment {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot   String
  itemId String

  @@id([userId, slot])
}

enum IdleStatus {
  ACTIVE
  /// The Champion beaten.
  BEATEN
  GIVEN_UP
}

/// An Idle Adventure run (README: Idle Adventure): one active per account at a time, beside any run or Battle Tower challenge.
model IdleRun {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @db.Uuid
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status      IdleStatus @default(ACTIVE)
  /// The idle package's IdleState (area, party, bag, money, badges). Contains RNG state – never return it to clients directly.
  state       Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version     Int
  seed        Int
  /// Its money has been moved to the bank (when it ended, beaten or given up).
  banked      Boolean    @default(false)
  /// The time the run has been played up to: each segment moves it on by its length (catch-up plays the time since).
  simulatedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, status])
}

/// The Idle Adventure's Pokédex, per account and species: seen, caught, and each stat's best IV and EV ever had by any of
/// the account's Pokémon of the species, in any run (each stat on its own). Later runs can start from a caught species.
model IdleDex {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// National Pokédex number.
  species   Int
  seen      Boolean  @default(false)
  caught    Boolean  @default(false)
  /// A shiny one caught: later runs can start with a shiny of the species.
  shiny     Boolean  @default(false)
  /// HP, Attack, Defense, Sp. Atk, Sp. Def, Speed.
  bestIv    Int[]    @default([0, 0, 0, 0, 0, 0])
  bestEv    Int[]    @default([0, 0, 0, 0, 0, 0])
  /// Its condition (Cool, Beauty, Cute, Smart, Tough, Sheen), raised by the Pokéblocks and Poffins fed to it: the entry is the
  /// Pokémon (the user's), so they stay with it for good (README: Super Contests).
  condition    Int[]    @default([0, 0, 0, 0, 0, 0])
  /// The moves it performs in the Super Contests' Acting Competition (2-4 of its level-up learnset).
  contestMoves String[] @default([])
  /// The Super Contest ribbons it has won ("cool-normal"…: ribbonId).
  ribbons      String[] @default([])
  updatedAt DateTime @updatedAt

  @@id([userId, species])
}
