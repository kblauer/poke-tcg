generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App profile for a Supabase Auth user. `id` matches auth.users.id.
model User {
  id            String          @id @db.Uuid
  email         String          @unique
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  /// Account-wide currency earned by beating runs, spent in the post-run shop.
  exp           Int             @default(0)
  /// ₱ banked from earlier runs: each run's ₱ is moved here when it ends.
  bank          Int             @default(0)
  /// Stardust, the crafting currency: earned for every card pulled from a pack, spent crafting cards in the deck builder.
  stardust      Int             @default(0)
  /// The trainer sprite shown on the Inventory tab (a name from the shared package's TRAINER_SPRITES); null is the default, Hilbert.
  trainerSprite String?
  /// The player's sprite on the run maps: 'female' for the girl (Leaf, Lyra, May); null is the boy (Red, Ethan, Brendan).
  playerGender  String?
  /// The name the account chose to be shown by, on its Community Decks (not unique; null until it's chosen). Never the
  /// Google profile's name (displayName), which is private.
  accountName   String?
  /// The account's deck played most recently (a run started with it, a run's battle switched to it, or a Practice battle):
  /// the next run's deck to start with. Not a relation: a deleted deck's id is just ignored.
  lastDeckId    String?         @db.Uuid
  /// Consumables used from the Inventory while no run was under way (item ids, already taken from the inventory; at most a
  /// run's 3): they all take effect when the next run starts (among that run's 3), then this is cleared.
  pendingConsumables String[]   @default([])
  /// The cosmetics in use (ids from the campaign package's COSMETICS): the player's card back, playmat and coin; null is the default.
  cardBack      String?
  playmat       String?
  coin          String?
  /// The Settings page's choices kept with the account, so they follow it to any browser (the shared package's
  /// ACCOUNT_SETTINGS: theme, font, skipFlips, options, reminders, music), each the web app's own value as a string.
  settings      Json            @default("{}")
  /// The Extras page's Berry Farm: when each berry's tree was last planted (the campaign package's BerryFarm, {} until it's
  /// first opened; a berry missing is planted then).
  berryFarm     Json            @default("{}")
  /// The berries the account has, a count per berry id ('cheri'): picked on the Berry Farm, used in the Berry Blender.
  berries       Json            @default("{}")
  /// The Berry Blender's top speed ever, in hundredths of an RPM (as the game's record).
  blenderRecord Int             @default(0)
  /// The Game Corner's Coin Case: coins bought with banked ₱ and played at the roulette and the slots (at most 9999).
  coins         Int             @default(0)
  decks         Deck[]
  games         Game[]
  runs          Run[]
  cardUnlocks   CardUnlock[]
  packUnlocks   PackUnlock[]
  favoriteCards FavoriteCard[]
  communityDecks CommunityDeck[]
  items        InventoryItem[]
  cosmetics    CosmeticUnlock[]
  equipment     Equipment[]
  pokeblocks    Pokeblock[]
  poffins       Poffin[]
}

enum CardKind {
  POKEMON
  ENERGY
  TRAINER
}

/// Card set, imported from TCGdex (e.g. "base1" = Base Set).
model CardSet {
  id          String    @id
  name        String
  /// TCGdex series id, e.g. "base", "gym", "neo".
  series      String
  releaseDate DateTime? @db.Date
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  cards       Card[]
}

/// Card catalog, imported from TCGdex. `id` is the TCGdex card id (e.g. "base1-4").
model Card {
  id         String         @id
  setId      String
  set        CardSet        @relation(fields: [setId], references: [id])
  /// Number within the set, e.g. "4".
  localId    String
  name       String
  kind       CardKind
  /// TCGdex asset base URL; append "/high.webp" or "/low.webp".
  imageUrl   String?
  rarity     String?
  hp         Int?
  /// Pokémon types, e.g. ["Fire"].
  types      String[]
  /// "Basic" | "Stage1" | "Stage2" (Pokémon only).
  stage      String?
  evolveFrom String?
  /// Remaining TCGdex fields: attacks, abilities, weaknesses, resistances, retreat, effect, ...
  data       Json
  deckCards  DeckCard[]
  unlocks    CardUnlock[]
  favorites  FavoriteCard[]
  communityDeckCards CommunityDeckCard[]

  @@index([setId])
  @@index([name])
}

model Deck {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Place in the account's deck list, which can be reordered (lowest first).
  position  Int        @default(0)
  /// Set on the account's automatic run deck: a copy of this run's deck that the server keeps up to date (read-only
  /// in the deck builder). Saving it when the run is over clears it; otherwise the next run takes it over.
  runId     String?    @unique @db.Uuid
  run       Run?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Starred on the Collection tab: offered under the run's deck choice (Favorite decks).
  favorite  Boolean    @default(false)
  /// The deck's own cosmetics (ids from the campaign package's COSMETICS), used in its battles; null is the account's
  /// (User.cardBack, playmat, coin). The run deck takes the run's starting (or switched-to) deck's.
  cardBack  String?
  playmat   String?
  coin      String?
  cards     DeckCard[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
}

model DeckCard {
  deckId   String @db.Uuid
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int

  @@id([deckId, cardId])
}

/// A deck published to the Community Decks tab: a snapshot of one of the author's decks when it was published (later
/// edits to the deck don't change it), its holos as their non-holo versions. Every account can see it and import it.
model CommunityDeck {
  id          String              @id @default(uuid()) @db.Uuid
  authorId    String              @db.Uuid
  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String              @default("")
  cards       CommunityDeckCard[]
  createdAt   DateTime            @default(now())

  @@index([createdAt])
}

model CommunityDeckCard {
  communityDeckId String        @db.Uuid
  communityDeck   CommunityDeck @relation(fields: [communityDeckId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card          @relation(fields: [cardId], references: [id])
  quantity        Int

  @@id([communityDeckId, cardId])
}

enum GameStatus {
  ACTIVE
  FINISHED
}

/// A single-player battle against a CPU opponent.
/// Engine player ids are "player" (the user) and "cpu".
model Game {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    GameStatus   @default(ACTIVE)
  /// Authoritative engine state. Contains hidden info – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Engine player id of the winner.
  winner    String?
  /// The run this battle belongs to (null for test games).
  runId     String?      @db.Uuid
  run       Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// The player's deck's cosmetics when the game began ({ cardBack, playmat, coin }, each an id or null for the
  /// account's own); null for a game without a deck of the account's (the test deck) or from before decks had them.
  cosmetics Json?
  actions   GameAction[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, updatedAt])
}

/// Append-only log of accepted actions (player and CPU) – enables replays and debugging.
model GameAction {
  id        BigInt   @id @default(autoincrement())
  gameId    String   @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Engine player id that took the action.
  playerId  String
  /// state.version after this action was applied.
  version   Int
  action    Json
  createdAt DateTime @default(now())

  @@unique([gameId, version])
}

enum RunStatus {
  ACTIVE
  WON
  LOST
}

/// A run: encounters and battles leading up to a gym leader (see @poke-tcg/campaign).
model Run {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Run type id, e.g. "celadon".
  type      String
  status    RunStatus @default(ACTIVE)
  /// The campaign package's RunState (map, HP, ₱, deck, current encounter). Contains RNG state – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Rewards for beating it (EXP, unlocks, badge) have been given.
  rewarded  Boolean   @default(false)
  /// Its ₱ has been moved to the bank (when it ended).
  banked    Boolean   @default(false)
  /// The post-run shop's stock after it (item ids), fixed the first time the shop is opened once it's over, so buying
  /// something doesn't change what's offered. Null until then.
  shop      Json?
  games     Game[]
  /// The automatic deck copying this run's deck, until it's saved or the next run takes it over.
  deck      Deck?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId, createdAt])
}

/// Cards an account has unlocked by beating runs, for the deck builder (to come).
model CardUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  /// Copies unlocked.
  quantity  Int
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Cards an account has marked as favorites on the Collection tab (its Favorites list and filter).
model FavoriteCard {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Booster packs an account can buy (by set id, e.g. "base2"): a run's first battle finished without conceding unlocks
/// its generation's next pack, beating a run all of them (see the campaign package's GENERATIONS).
/// A Pokéblock made in the Extras page's Berry Blender (the campaign package's makePokeblock): its colour (POKEBLOCK_COLORS),
/// its 5 flavours (spicy, dry, sweet, bitter, sour), its feel, and the berries and top speed it was made with.
model Pokeblock {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  color     String
  flavors   Int[]
  feel      Int
  berries   String[]
  maxRpm    Int
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A Poffin cooked on the Extras page (the campaign package's makePoffin): its type (an index into POFFIN_TYPES), its 5
/// flavours (spicy, dry, sweet, bitter, sour), its smoothness, and the berries, time (frames, 30 a second), spills and
/// burns it was cooked with.
model Poffin {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       Int
  flavors    Int[]
  smoothness Int
  berries    String[]
  frames     Int
  spills     Int
  burns      Int
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Cosmetics an account has bought (`cosmeticId`: a key of the campaign package's COSMETICS). The defaults, and those
/// unlocked by beating a run type, have no row: they're worked out (hasCosmetic).

model CosmeticUnlock {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId String
  createdAt  DateTime @default(now())

  @@id([userId, cosmeticId])
}

model PackUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  createdAt DateTime @default(now())

  @@id([userId, setId])
}

/// Items an account owns (consumables, misc items, key items, equipment). `itemId` is a key of the campaign package's ITEMS.
model InventoryItem {
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int

  @@id([userId, itemId])
}

/// What's equipped in each slot (head, chest, legs, pokeball, accessory1, accessory2).
model Equipment {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot   String
  itemId String

  @@id([userId, slot])
}
