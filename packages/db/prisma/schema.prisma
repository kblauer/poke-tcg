generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App profile for a Supabase Auth user. `id` matches auth.users.id.
model User {
  id            String          @id @db.Uuid
  email         String          @unique
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  /// Account-wide currency earned by beating runs, spent in the post-run shop.
  exp           Int             @default(0)
  /// ₱ banked from earlier runs: each run's ₱ is moved here when it ends.
  bank          Int             @default(0)
  /// Stardust, the crafting currency: earned for every card pulled from a pack, spent crafting cards in the deck builder.
  stardust      Int             @default(0)
  decks         Deck[]
  games         Game[]
  runs          Run[]
  cardUnlocks   CardUnlock[]
  packUnlocks   PackUnlock[]
  favoriteCards FavoriteCard[]
  items         InventoryItem[]
  equipment     Equipment[]
}

enum CardKind {
  POKEMON
  ENERGY
  TRAINER
}

/// Card set, imported from TCGdex (e.g. "base1" = Base Set).
model CardSet {
  id          String    @id
  name        String
  /// TCGdex series id, e.g. "base", "gym", "neo".
  series      String
  releaseDate DateTime? @db.Date
  cardCount   Int
  logoUrl     String?
  symbolUrl   String?
  cards       Card[]
}

/// Card catalog, imported from TCGdex. `id` is the TCGdex card id (e.g. "base1-4").
model Card {
  id         String         @id
  setId      String
  set        CardSet        @relation(fields: [setId], references: [id])
  /// Number within the set, e.g. "4".
  localId    String
  name       String
  kind       CardKind
  /// TCGdex asset base URL; append "/high.webp" or "/low.webp".
  imageUrl   String?
  rarity     String?
  hp         Int?
  /// Pokémon types, e.g. ["Fire"].
  types      String[]
  /// "Basic" | "Stage1" | "Stage2" (Pokémon only).
  stage      String?
  evolveFrom String?
  /// Remaining TCGdex fields: attacks, abilities, weaknesses, resistances, retreat, effect, ...
  data       Json
  deckCards  DeckCard[]
  unlocks    CardUnlock[]
  favorites  FavoriteCard[]

  @@index([setId])
  @@index([name])
}

model Deck {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Place in the account's deck list, which can be reordered (lowest first).
  position  Int        @default(0)
  /// Set on the account's automatic run deck: a copy of this run's deck that the server keeps up to date (read-only
  /// in the deck builder). Saving it when the run is over clears it; otherwise the next run takes it over.
  runId     String?    @unique @db.Uuid
  run       Run?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  cards     DeckCard[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId])
}

model DeckCard {
  deckId   String @db.Uuid
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int

  @@id([deckId, cardId])
}

enum GameStatus {
  ACTIVE
  FINISHED
}

/// A single-player battle against a CPU opponent.
/// Engine player ids are "player" (the user) and "cpu".
model Game {
  id        String       @id @default(uuid()) @db.Uuid
  ownerId   String       @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    GameStatus   @default(ACTIVE)
  /// Authoritative engine state. Contains hidden info – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Engine player id of the winner.
  winner    String?
  /// The run this battle belongs to (null for test games).
  runId     String?      @db.Uuid
  run       Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  actions   GameAction[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId, updatedAt])
}

/// Append-only log of accepted actions (player and CPU) – enables replays and debugging.
model GameAction {
  id        BigInt   @id @default(autoincrement())
  gameId    String   @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Engine player id that took the action.
  playerId  String
  /// state.version after this action was applied.
  version   Int
  action    Json
  createdAt DateTime @default(now())

  @@unique([gameId, version])
}

enum RunStatus {
  ACTIVE
  WON
  LOST
}

/// A run: encounters and battles leading up to a gym leader (see @poke-tcg/campaign).
model Run {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Run type id, e.g. "celadon".
  type      String
  status    RunStatus @default(ACTIVE)
  /// The campaign package's RunState (map, HP, ₱, deck, current encounter). Contains RNG state – never return it to clients directly.
  state     Json
  /// Mirrors state.version; used for optimistic concurrency on writes.
  version   Int
  seed      Int
  /// Rewards for beating it (EXP, unlocks, badge) have been given.
  rewarded  Boolean   @default(false)
  /// Its ₱ has been moved to the bank (when it ended).
  banked    Boolean   @default(false)
  games     Game[]
  /// The automatic deck copying this run's deck, until it's saved or the next run takes it over.
  deck      Deck?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId, createdAt])
}

/// Cards an account has unlocked by beating runs, for the deck builder (to come).
model CardUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  /// Copies unlocked.
  quantity  Int
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Cards an account has marked as favorites on the Collection tab (its Favorites list and filter).
model FavoriteCard {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, cardId])
}

/// Booster packs an account can buy (by set id, e.g. "base2"): a run's first battle finished without conceding unlocks
/// its generation's next pack, beating a run all of them (see the campaign package's GENERATIONS).
model PackUnlock {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  createdAt DateTime @default(now())

  @@id([userId, setId])
}

/// Items an account owns (consumables, misc items, key items, equipment). `itemId` is a key of the campaign package's ITEMS.
model InventoryItem {
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int

  @@id([userId, itemId])
}

/// What's equipped in each slot (head, chest, legs, pokeball, accessory1, accessory2).
model Equipment {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot   String
  itemId String

  @@id([userId, slot])
}
