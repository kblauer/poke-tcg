{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "DIRECT_URL", "SUPABASE_URL", "SUPABASE_JWT_SECRET", "VITE_*"],
  "agentGuidance": false,
  "tasks": {
    "generate": { "cache": false },
    "build": { "dependsOn": ["^build", "^generate", "generate"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck", "^generate", "generate"] },
    "test": { "dependsOn": ["^generate", "generate"] },
    "dev": { "dependsOn": ["^generate", "generate"], "cache": false, "persistent": true }
  }
}
